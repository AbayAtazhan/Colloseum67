# ---------------------------------------------------------------------------
# SWARM TAB configuration
#
# Copy to .env and fill in locally. .env files are gitignored; never commit
# keys. The agent runtime only needs EXECUTOR_PRIVATE_KEY (and
# RELAYER_PRIVATE_KEY for the facilitator). Browser mission/revocation
# signatures use MetaMask; USER_OWNER_PRIVATE_KEY is only for the test-owner CLI.
# ---------------------------------------------------------------------------

# base-sepolia | local (local = Hardhat chain started by `npm run dev:local`)
SWARM_TAB_NETWORK=base-sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Official Circle test USDC on Base Sepolia. Verified on-chain:
# symbol=USDC, decimals=6. The app also verifies this at runtime.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Mission policy (human-readable decimal strings; the app stores minimal units)
MISSION_BUDGET_USDC=0.05
PER_CALL_MAX_USDC=0.02
MISSION_VALIDITY_SECONDS=86400

# One or two recipients that agents may pay. Each provider has a fixed payee:
# ALLOWED_RECIPIENT_1 = code provider, ALLOWED_RECIPIENT_2 = activity provider.
# The on-chain MissionPolicyEnforcer rejects every other transfer recipient.
ALLOWED_RECIPIENT_1=0x0000000000000000000000000000000000000001
ALLOWED_RECIPIENT_2=0x0000000000000000000000000000000000000002

# Optional generated test owner for Base Sepolia CLI runs. Never put the
# user's personal MetaMask private key here. Local demo accounts are automatic.
# USER_OWNER_PRIVATE_KEY=0x...

# Server executor EOA. Signs one-shot child delegations; needs no ETH itself.
# EXECUTOR_PRIVATE_KEY=0x...

# Relayer/facilitator EOA: redeems the ERC-7710 permission and pays settlement
# gas. Falls back to EXECUTOR_PRIVATE_KEY when unset, but a separate key is
# recommended (and needed to honor the executor/relayer split).
# RELAYER_PRIVATE_KEY=0x...

# Deployer EOA: pays one-time deployments (MissionPolicyEnforcer, the user's
# smart account). Falls back to EXECUTOR_PRIVATE_KEY when unset. It never
# touches mission funds.
# DEPLOYER_PRIVATE_KEY=0x...

# Deployed MissionPolicyEnforcer (contracts/MissionPolicyEnforcer.sol).
# On Base Sepolia this is a one-time deployment funded by the deployer.
MISSION_POLICY_ENFORCER_ADDRESS=

# DeepSeek (server-side only, never sent to the browser)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Clearly-labelled deterministic test LLM; only for local demos without a key.
# SWARM_TAB_FAKE_LLM=1

# SQLite file for missions/attempts/receipts/purchases/reports. dev:local derives
# a fresh *.local-<session>.db journal for each new chain and preserves old files.
DATABASE_PATH=./data/swarm-tab.db

# Public URL of the running app (used by the agents to call the paid provider
# endpoints over HTTP; `npm run dev:local` sets it automatically)
SWARM_TAB_PUBLIC_URL=http://127.0.0.1:3000

# Local mode overrides (set automatically by `npm run dev:local`)
# LOCAL_CHAIN_CONTEXT=tests/harness/.chain-context.json

# Optional: dev/prod port for `npm run dev:local` (default 3000)
# PORT=3000

# Standalone hosted demo (Render): secrets belong in hosting Environment.
# Cloud startup does not read this .env file. See docs/HOSTING.md.
# DEMO_ACCESS_PASSWORD= (at least 16 characters; generated by render.yaml)
# SWARM_TAB_HOSTED_URL=https://your-service.onrender.com
# SWARM_TAB_INTERNAL_PORT=3001
# SWARM_TAB_DIST_DIR=.next-cloud (optional isolated local production build)
