{
  "name": "swarm-tab",
  "version": "0.1.0",
  "private": true,
  "description": "SWARM TAB — shared onchain research budget for multiple AI agents via ERC-7710 delegations (x402-ready payment core).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloud": "node scripts/build-cloud.mjs",
    "start": "next start",
    "start:cloud": "node build/start-cloud.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run contracts:compile && vitest run",
    "test:watch": "vitest",
    "contracts:compile": "hardhat compile",
    "chain:check": "tsx scripts/check-chain.ts",
    "network:prepare": "tsx scripts/prepare-testnet.ts",
    "demo:budget": "npm run contracts:compile && tsx scripts/demo-shared-budget.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "npm run contracts:compile && vitest run --project integration",
    "contracts:deploy-enforcer": "npm run contracts:compile && tsx scripts/deploy-enforcer.ts",
    "dev:local": "npm run contracts:compile && tsx scripts/dev-local.ts",
    "demo:mission": "tsx scripts/demo-mission.ts",
    "deepseek:check": "tsx scripts/deepseek-check.ts",
    "base:mission": "tsx scripts/base-mission.ts"
  },
  "dependencies": {
    "@metamask/delegation-abis": "^2.0.0",
    "@metamask/smart-accounts-kit": "^2.0.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/next": "^2.28.0",
    "dotenv": "^17.2.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@metamask/eth-sig-util": "9.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "esbuild": "0.28.2",
    "hardhat": "^3.18.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
